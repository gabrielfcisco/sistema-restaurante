{
  "name": "@restaurante/mesa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node ../../scripts/dev-desktop.mjs",
    "dev:ui": "vite --host localhost",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@restaurante/desktop": "0.1.0",
    "@restaurante/api-client": "0.1.0",
    "@restaurante/ui": "0.1.0",
    "jsqr": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "br.grupo9.restaurante.mesa",
    "productName": "Restaurante Mesa",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
